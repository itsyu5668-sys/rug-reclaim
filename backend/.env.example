# Public, non-secret config for local dev. Never commit real keys.
PORT=3000

# Supabase (reuse the existing project; tables are namespaced rug_*)
SUPABASE_URL=https://tkgotpzqwasttopwsxpd.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Solana RPC used by the /rpc proxy. Public endpoint works for dev;
# set a Helius/QuickNode key in production.
RPC_URL=https://api.mainnet-beta.solana.com

# Fee wallet receiving the protocol cut (30% = 3000 bps). MUST be set in prod.
FEE_WALLET=
FEE_BPS=3000

# Referral economics: bps of the *fee* routed to the referrer, in-transaction.
# e.g. 1667 = referrer gets ~16.67% of the 30% fee (~5% of the reclaim).
REFERRER_BPS_OF_FEE=1667

# First cleanup is fee-free (conversion tactic).
FIRST_CLAIM_FREE=true

# Comma-separated origins allowed to call the API (extension + landing page).
ALLOWED_ORIGINS=chrome-extension://*
